# ==============================================================================
# QMOOSA BOT - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with production credentials.
# ==============================================================================

# Server & Network Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=false
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here

# Post-Quantum Cryptography (PQC) Settings
PQC_SECURITY_LEVEL=ML-KEM-768
PQC_SIGNING_ALGORITHM=ML-DSA-65
PQC_KEY_VAULT_PATH=data/qmoosa_vault.pqc
PQC_SALT=production_pqc_salt_entropy_seed_9931

# AI Model Provider API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...
GEMINI_API_KEY=AIzaSy...
XAI_API_KEY=xai-...
OPENAI_API_KEY=sk-...
LOCAL_MODEL_ENDPOINT=http://localhost:11434

# Full Screen Controller & Virtual Desktop
DISPLAY_SERVER=:99
VIRTUAL_SCREEN_WIDTH=1920
VIRTUAL_SCREEN_HEIGHT=1080
NOVNC_PORT=6080
ENABLE_BEZIER_SMOOTHING=true
ENABLE_HUMAN_TYPING_JITTER=true
RESIDENTIAL_PROXY_URL=

# x402 Bazaar Protocol & Escrow
X402_NETWORK=mainnet
X402_DEFAULT_TOKEN=QALGO
X402_CHALLENGE_TTL_SECONDS=300
X402_PLATFORM_FEE_PERCENT=0.02
X402_FEE_BURN_RATE=0.50

# Blockchain RPC & Multi-Wallet Endpoints
ALGORAND_ALGOD_URL=https://mainnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://mainnet-idx.algonode.cloud
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_EVM_RPC_URL=https://mainnet.base.org
LIGHTNING_LND_REST_URL=https://localhost:8080

# Fiat & Payment Webhooks
UPI_MERCHANT_VPA=qmoosa@bot
UPI_MERCHANT_NAME=Qmoosa Autonomous Technologies
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database & Cache Persistence
DATABASE_URL=postgresql://qmoosa_admin:secure_password_here@localhost:5432/qmoosa_bot_db
REDIS_URL=redis://localhost:6379/0
